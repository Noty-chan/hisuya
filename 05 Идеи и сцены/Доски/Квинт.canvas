    {
      "id": "7e6b9304875694ef",
      "type": "text",
      "text": "Боад?\nКаин?\nНиэль Аквайра?",
      "x": -560,
      "y": -180,
      "width": 250,
      "height": 100
    },
    {
      "id": "355811ee0ed19948",
      "type": "text",
      "text": "Квинт сейчас живет в таверне \"Красавчик Боад\" за 7 медных в день. \n\nВместе с Мари. Их приютил Леон Арент. \n\n2 средний уровень 14 улица\n\nЕсть странный постоялец",
      "x": -560,
      "y": -60,
      "width": 250,
      "height": 320
    },
    {
      "id": "295270c9bd4f776d",
      "type": "text",
      "text": "Нора - повар в таверне, короткое каре темное\nДель - помощник повара в таверне, раненый страж",
      "x": -840,
      "y": -360,
      "width": 250,
      "height": 620
    },
    {
      "id": "828c06b388ef6e47",
      "type": "text",
      "text": "Поход к Манретэннам",
      "x": 0,
      "y": -140,
      "width": 250,
      "height": 60,
      "color": "3"
    },
    {
      "id": "1c0ca3a57678c3ca",
      "type": "text",
      "text": "",
      "x": -60,
      "y": -50,
      "width": 360,
      "height": 210
    },
    {
      "id": "98c82a8260980b3e",
      "type": "text",
      "text": "На месте уже копошится жемчужина",
      "x": 340,
      "y": -50,
      "width": 250,
      "height": 60
    },
    {
      "id": "6f1742f02ed45d93",
      "type": "text",
      "text": "О нем уже знает Боад",
      "x": 340,
      "y": 25,
      "width": 250,
      "height": 60
    },
    {
      "id": "ac3f21cbb8cc4b28",
